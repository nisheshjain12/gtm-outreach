# Copy to .env and fill in (Phase 0). Never commit the real .env.
GEMINI_API_KEY=
TAVILY_API_KEY=
SUPABASE_URL=
SUPABASE_KEY=

# Optional extra Gemini keys for more daily quota. The client rotates to the
# next key when the current key's DAILY quota is exhausted.
# GEMINI_API_KEY_2=
# GEMINI_API_KEY_3=
# ...up to GEMINI_API_KEY_5
# Or bundle several at once (comma-separated):
# GEMINI_API_KEYS=key_a,key_b,key_c
#
# IMPORTANT: Gemini free-tier limits are per Google Cloud PROJECT, not per key.
# Two keys from the same project share one quota and won't help. To actually
# double your quota, create each key in a DIFFERENT project (or different
# Google account) at https://aistudio.google.com/apikey

# Optional model overrides (defaults in src/config.py)
# MODEL_EXTRACT=gemini-2.5-flash
# MODEL_HOOK=gemini-2.5-flash
# MODEL_DRAFT=gemini-2.5-flash
# MODEL_CLASSIFY=gemini-2.5-flash
