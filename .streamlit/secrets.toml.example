# Copy to .streamlit/secrets.toml for Streamlit Cloud deploy (Phase 9).
# Locally, .env is used instead. Never commit the real secrets.toml.
GEMINI_API_KEY = ""
TAVILY_API_KEY = ""
SUPABASE_URL = ""
SUPABASE_KEY = ""

# Optional extra Gemini keys for more daily quota. The client rotates to the
# next key when the current key's DAILY quota is exhausted.
# Each key needs its own quota — create them in DIFFERENT Google Cloud
# projects (free-tier limits are per-project, not per-key).
# GEMINI_API_KEY_2 = ""
# GEMINI_API_KEY_3 = ""
